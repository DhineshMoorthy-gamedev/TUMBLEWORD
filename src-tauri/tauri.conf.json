{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rotatle",
  "version": "0.0.21",
  "identifier": "OLAIDigitalStudios.Rotatle",
  "build": {
    "frontendDist": "../dist/itch"
  },
  "app": {
    "windows": [
      {
        "title": "Rotatle",
        "width": 420,
        "height": 870,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
